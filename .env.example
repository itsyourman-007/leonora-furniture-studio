PORT=3000
STORE_CURRENCY=INR
# Canonical public HTTPS origin used for API CORS, for example https://store.example.com
PUBLIC_ORIGIN=

# Razorpay live/test keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Leonora Furniture Studio <orders@yourdomain.com>
STORE_EMAIL=orders@yourdomain.com
STUDIO_EMAIL=

# Private admin dashboard credentials - CHANGE THESE IN PRODUCTION
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production product-image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
